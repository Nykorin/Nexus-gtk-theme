/* CachyOS-Nord for Dolphin Emulator: navy backgrounds, cyan text and accent, cyan-tinted
   borders, selections filled cyan at 0.6 with navy text, as in the GTK theme.

   A template: install.sh replaces @RES@ with the absolute path of the resources folder,
   since Dolphin applies the stylesheet's text without a base folder for relative paths.
   On Linux, Dolphin keeps the system palette for user styles, so every color is set here. */

/* Base */
QWidget {
    background-color: #0F121C;
    color: #47ADD6;
    selection-background-color: rgba(71, 173, 214, 0.6);
    selection-color: #0F121C;
}

QWidget:disabled {
    color: #3A5A6B;
}

QLabel,
QCheckBox,
QRadioButton {
    background-color: transparent;
}

QToolTip {
    background-color: #181B28;
    color: #47ADD6;
    border: 1px solid rgba(71, 173, 214, 0.3);
    padding: 4px;
}

/* Menu bar and menus */
QMenuBar {
    background-color: #0F121C;
    border-bottom: 1px solid rgba(71, 173, 214, 0.12);
}

QMenuBar::item {
    background: transparent;
    padding: 4px 10px;
}

QMenuBar::item:selected,
QMenuBar::item:pressed {
    background-color: rgba(71, 173, 214, 0.12);
    color: #86C9E4;
}

QMenu {
    background-color: #181B28;
    border: 1px solid rgba(71, 173, 214, 0.3);
    padding: 4px 0;
}

QMenu::item {
    background: transparent;
    padding: 5px 24px 5px 28px;
}

QMenu::item:selected {
    background-color: rgba(71, 173, 214, 0.6);
    color: #0F121C;
}

QMenu::item:disabled {
    color: #3A5A6B;
}

QMenu::separator {
    height: 1px;
    margin: 4px 0;
    background-color: rgba(71, 173, 214, 0.15);
}

QMenu::indicator {
    width: 14px;
    height: 14px;
    margin-left: 6px;
}

QMenu::indicator:checked { image: url(@RES@/check.svg); }
QMenu::indicator:exclusive:checked { image: url(@RES@/dot.svg); }

/* Tool bar */
QToolBar {
    background-color: #0F121C;
    border: none;
    border-bottom: 1px solid rgba(71, 173, 214, 0.12);
    spacing: 2px;
    padding: 2px;
}

QToolBar::separator {
    width: 1px;
    margin: 4px 3px;
    background-color: rgba(71, 173, 214, 0.15);
}

QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 3px;
    padding: 3px;
}

QToolButton:hover {
    background-color: rgba(71, 173, 214, 0.1);
    border-color: rgba(71, 173, 214, 0.2);
}

QToolButton:pressed,
QToolButton:checked {
    background-color: rgba(71, 173, 214, 0.2);
}

QToolButton[popupMode="1"] {
    padding-right: 14px;
}

QToolButton::menu-button {
    border: none;
    width: 12px;
}

QToolButton::menu-arrow,
QToolButton::menu-indicator {
    image: url(@RES@/arrow-down.svg);
    width: 10px;
    height: 10px;
}

/* Status bar, splitters, dock panels */
QStatusBar {
    background-color: #0F121C;
    border-top: 1px solid rgba(71, 173, 214, 0.12);
}

QStatusBar::item {
    border: none;
}

QSplitter::handle {
    background-color: rgba(71, 173, 214, 0.12);
}

QSplitter::handle:hover {
    background-color: rgba(71, 173, 214, 0.4);
}

QMainWindow::separator {
    width: 4px;
    height: 4px;
    background-color: rgba(71, 173, 214, 0.12);
}

QDockWidget {
    titlebar-close-icon: url(@RES@/close.svg);
    titlebar-normal-icon: url(@RES@/undock.svg);
}

QDockWidget::title {
    background-color: #131621;
    border-bottom: 1px solid rgba(71, 173, 214, 0.15);
    padding: 4px 6px;
    text-align: left;
}

QDockWidget::close-button,
QDockWidget::float-button {
    background: transparent;
    border: none;
    padding: 1px;
}

QDockWidget::close-button:hover,
QDockWidget::float-button:hover {
    background-color: rgba(71, 173, 214, 0.15);
}

/* Lists, tables and trees (the game list, the settings sidebar, the log) */
QAbstractItemView {
    background-color: #131621;
    alternate-background-color: #151826;
    border: 1px solid rgba(71, 173, 214, 0.15);
    gridline-color: rgba(71, 173, 214, 0.08);
    outline: none;
}

QAbstractItemView::item:hover {
    background-color: rgba(71, 173, 214, 0.08);
}

QAbstractItemView::item:selected {
    background-color: rgba(71, 173, 214, 0.6);
    color: #0F121C;
}

QTreeView::branch {
    background: transparent;
}

QTreeView::branch:has-children:closed { image: url(@RES@/arrow-right.svg); }
QTreeView::branch:has-children:open { image: url(@RES@/arrow-down.svg); }

QHeaderView {
    background-color: #131621;
    border: none;
}

QHeaderView::section {
    background-color: #131621;
    color: #86C9E4;
    border: none;
    border-right: 1px solid rgba(71, 173, 214, 0.12);
    border-bottom: 1px solid rgba(71, 173, 214, 0.2);
    padding: 4px 6px;
}

QHeaderView::section:hover {
    background-color: #181B28;
}

QHeaderView::down-arrow { image: url(@RES@/arrow-down.svg); width: 10px; height: 10px; }
QHeaderView::up-arrow { image: url(@RES@/arrow-up.svg); width: 10px; height: 10px; }

QTableCornerButton::section {
    background-color: #131621;
    border: none;
}

/* Text fields */
QLineEdit,
QTextEdit,
QPlainTextEdit,
QAbstractSpinBox {
    background-color: #131621;
    border: 1px solid rgba(71, 173, 214, 0.2);
    border-radius: 3px;
    padding: 3px 5px;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QAbstractSpinBox:focus {
    border-color: #47ADD6;
}

QLineEdit:disabled,
QAbstractSpinBox:disabled {
    background-color: #0F121C;
    border-color: rgba(71, 173, 214, 0.1);
}

QAbstractSpinBox {
    padding-right: 16px;
}

QAbstractSpinBox::up-button,
QAbstractSpinBox::down-button {
    background: transparent;
    border: none;
    width: 16px;
}

QAbstractSpinBox::up-button:hover,
QAbstractSpinBox::down-button:hover {
    background-color: rgba(71, 173, 214, 0.15);
}

QAbstractSpinBox::up-arrow { image: url(@RES@/arrow-up.svg); width: 10px; height: 10px; }
QAbstractSpinBox::down-arrow { image: url(@RES@/arrow-down.svg); width: 10px; height: 10px; }
QAbstractSpinBox::up-arrow:disabled { image: url(@RES@/arrow-up-disabled.svg); }
QAbstractSpinBox::down-arrow:disabled { image: url(@RES@/arrow-down-disabled.svg); }

/* Buttons */
QPushButton {
    background-color: #181B28;
    border: 1px solid rgba(71, 173, 214, 0.25);
    border-radius: 3px;
    padding: 4px 14px;
    min-height: 18px;
}

QPushButton:hover {
    background-color: #1C2030;
    border-color: rgba(71, 173, 214, 0.5);
}

QPushButton:pressed,
QPushButton:checked {
    background-color: rgba(71, 173, 214, 0.25);
}

QPushButton:default {
    border-color: #47ADD6;
}

QPushButton:disabled {
    background-color: #131621;
    border-color: rgba(71, 173, 214, 0.1);
}

/* Drop-down lists */
QComboBox {
    background-color: #181B28;
    border: 1px solid rgba(71, 173, 214, 0.25);
    border-radius: 3px;
    padding: 3px 24px 3px 6px;
    min-height: 18px;
}

QComboBox:hover {
    border-color: rgba(71, 173, 214, 0.5);
}

QComboBox:editable {
    background-color: #131621;
}

QComboBox:disabled {
    background-color: #131621;
    border-color: rgba(71, 173, 214, 0.1);
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox::down-arrow { image: url(@RES@/arrow-down.svg); width: 10px; height: 10px; }
QComboBox::down-arrow:disabled { image: url(@RES@/arrow-down-disabled.svg); }

QComboBox QAbstractItemView {
    background-color: #181B28;
    border: 1px solid rgba(71, 173, 214, 0.3);
    selection-background-color: rgba(71, 173, 214, 0.6);
    selection-color: #0F121C;
}

/* Check boxes and radio buttons: cyan border, the GTK theme's check, dash and dot */
QCheckBox,
QRadioButton {
    spacing: 6px;
}

QCheckBox::indicator,
QRadioButton::indicator,
QGroupBox::indicator,
QAbstractItemView::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid rgba(71, 173, 214, 0.35);
    background-color: #131621;
    border-radius: 2px;
}

QRadioButton::indicator {
    border-radius: 8px;
}

QCheckBox::indicator:hover,
QRadioButton::indicator:hover,
QGroupBox::indicator:hover {
    border-color: rgba(71, 173, 214, 0.7);
}

QCheckBox::indicator:checked,
QGroupBox::indicator:checked,
QAbstractItemView::indicator:checked { image: url(@RES@/check.svg); }
QCheckBox::indicator:indeterminate { image: url(@RES@/dash.svg); }
QRadioButton::indicator:checked { image: url(@RES@/dot.svg); }

QCheckBox::indicator:disabled,
QRadioButton::indicator:disabled,
QGroupBox::indicator:disabled {
    border-color: rgba(71, 173, 214, 0.15);
    background-color: transparent;
}

QCheckBox::indicator:checked:disabled,
QGroupBox::indicator:checked:disabled { image: url(@RES@/check-disabled.svg); }
QCheckBox::indicator:indeterminate:disabled { image: url(@RES@/dash-disabled.svg); }
QRadioButton::indicator:checked:disabled { image: url(@RES@/dot-disabled.svg); }

/* Group boxes */
QGroupBox {
    border: 1px solid rgba(71, 173, 214, 0.2);
    border-radius: 4px;
    margin-top: 1.4em;
    padding-top: 0.4em;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    padding: 0 4px;
    color: #86C9E4;
}

/* Tabs */
QTabWidget::pane {
    border: 1px solid rgba(71, 173, 214, 0.2);
    top: -1px;
}

QTabBar::tab {
    background-color: #0F121C;
    border: 1px solid rgba(71, 173, 214, 0.15);
    border-bottom: none;
    padding: 5px 12px;
    margin-right: 2px;
}

QTabBar::tab:hover {
    background-color: #131621;
    color: #86C9E4;
}

QTabBar::tab:selected {
    background-color: #131621;
    color: #86C9E4;
    border-top: 3px solid #47ADD6;
}

QTabBar::scroller {
    width: 20px;
}

QTabBar QToolButton {
    background-color: #131621;
}

QTabBar QToolButton::left-arrow { image: url(@RES@/arrow-left.svg); }
QTabBar QToolButton::right-arrow { image: url(@RES@/arrow-right.svg); }

/* Sliders and progress bars */
QSlider::groove:horizontal {
    height: 4px;
    background-color: rgba(71, 173, 214, 0.2);
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background-color: #47ADD6;
    border-radius: 2px;
}

QSlider::groove:vertical {
    width: 4px;
    background-color: rgba(71, 173, 214, 0.2);
    border-radius: 2px;
}

QSlider::add-page:vertical {
    background-color: #47ADD6;
    border-radius: 2px;
}

QSlider::handle {
    background-color: #86C9E4;
    border: 2px solid #0F121C;
    width: 12px;
    height: 12px;
    margin: -6px;
    border-radius: 8px;
}

QSlider::handle:hover {
    background-color: #ADDCEE;
}

QSlider::handle:disabled {
    background-color: #3A5A6B;
}

QProgressBar {
    background-color: #131621;
    border: 1px solid rgba(71, 173, 214, 0.2);
    border-radius: 3px;
    text-align: center;
    color: #86C9E4;
}

QProgressBar::chunk {
    background-color: rgba(71, 173, 214, 0.6);
    border-radius: 2px;
}

/* Scroll bars: thin, the slider cyan at 0.3, 0.5 on hover, 0.8 while dragged */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0;
}

QScrollBar::handle {
    background-color: rgba(71, 173, 214, 0.3);
    border-radius: 3px;
    margin: 2px;
}

QScrollBar::handle:vertical { min-height: 24px; }
QScrollBar::handle:horizontal { min-width: 24px; }

QScrollBar::handle:hover {
    background-color: rgba(71, 173, 214, 0.5);
}

QScrollBar::handle:pressed {
    background-color: rgba(71, 173, 214, 0.8);
}

QScrollBar::add-line,
QScrollBar::sub-line {
    width: 0;
    height: 0;
    border: none;
}

QScrollBar::add-page,
QScrollBar::sub-page {
    background: transparent;
}

QAbstractScrollArea::corner {
    background: transparent;
}
