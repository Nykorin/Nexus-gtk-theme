{
	"name": "CachyOS-Nord",
	"author": "CachyOS-Nord GTK theme",
	"variables": {
		"navy": "#0F121C",
		"surface": "#181B28",
		"base": "#131621",
		"cyan": "#47ADD6",
		"cyan_light": "#71C0DF",
		"slate": "#526D7A",
		"red": "#BF616A",
		"green": "#7AE070",
		"olive": "#ADAD70",
		"blue": "#81A1C1",
		"mauve": "#AD7AA3",
		"white": "#D8DEE9"
	},
	"globals": {
		"background": "var(navy)",
		"foreground": "var(cyan)",
		"caret": "var(cyan)",
		"line_highlight": "var(surface)",
		"selection": "color(var(cyan) alpha(0.3))",
		"selection_border": "color(var(cyan) alpha(0.5))",
		"inactive_selection": "color(var(cyan) alpha(0.15))",
		"misspelling": "var(red)",
		"gutter": "var(navy)",
		"gutter_foreground": "var(slate)",
		"gutter_foreground_highlight": "var(cyan)",
		"line_diff_added": "var(green)",
		"line_diff_modified": "var(olive)",
		"line_diff_deleted": "var(red)",
		"accent": "var(cyan)",
		"guide": "color(var(slate) alpha(0.35))",
		"active_guide": "var(slate)",
		"stack_guide": "color(var(slate) alpha(0.6))",
		"find_highlight": "var(olive)",
		"find_highlight_foreground": "var(navy)",
		"highlight": "var(olive)",
		"brackets_foreground": "var(cyan_light)",
		"brackets_options": "underline",
		"bracket_contents_foreground": "var(cyan_light)",
		"tags_foreground": "var(cyan_light)",
		"tags_options": "stippled_underline",
		"minimap_border": "color(var(cyan) alpha(0.2))",
		"shadow": "color(#000000 alpha(0.4))",
		"popup_css": "html { background-color: #181B28; color: #47ADD6; } a { color: #71C0DF; }"
	},
	"rules": [
		{
			"name": "Comment",
			"scope": "comment, punctuation.definition.comment",
			"foreground": "var(slate)",
			"font_style": "italic"
		},
		{
			"name": "String",
			"scope": "string",
			"foreground": "var(green)"
		},
		{
			"name": "Escape",
			"scope": "constant.character.escape, constant.other.placeholder",
			"foreground": "var(cyan_light)"
		},
		{
			"name": "Number and constant",
			"scope": "constant.numeric, constant.language, constant.character, constant.other",
			"foreground": "var(olive)"
		},
		{
			"name": "Keyword and storage",
			"scope": "keyword, storage, keyword.operator.word",
			"foreground": "var(mauve)"
		},
		{
			"name": "Operator and punctuation",
			"scope": "keyword.operator, punctuation.separator, punctuation.accessor",
			"foreground": "var(white)"
		},
		{
			"name": "Function",
			"scope": "entity.name.function, support.function, meta.function-call variable.function, variable.function",
			"foreground": "var(cyan_light)"
		},
		{
			"name": "Type and class",
			"scope": "entity.name.type, entity.name.class, entity.other.inherited-class, support.type, support.class, storage.type.class",
			"foreground": "var(blue)"
		},
		{
			"name": "Parameter",
			"scope": "variable.parameter",
			"foreground": "var(white)",
			"font_style": "italic"
		},
		{
			"name": "Language variable",
			"scope": "variable.language",
			"foreground": "var(mauve)",
			"font_style": "italic"
		},
		{
			"name": "Tag",
			"scope": "entity.name.tag",
			"foreground": "var(mauve)"
		},
		{
			"name": "Attribute",
			"scope": "entity.other.attribute-name",
			"foreground": "var(olive)"
		},
		{
			"name": "Mapping key (JSON, YAML)",
			"scope": "meta.mapping.key string, meta.mapping.key.yaml",
			"foreground": "var(blue)"
		},
		{
			"name": "Diff header",
			"scope": "meta.diff.header, meta.header.diff, meta.diff.index",
			"foreground": "var(blue)",
			"font_style": "bold"
		},
		{
			"name": "Diff range",
			"scope": "meta.diff.range",
			"foreground": "var(mauve)"
		},
		{
			"name": "Decorator",
			"scope": "meta.annotation, punctuation.definition.annotation, entity.name.function.decorator",
			"foreground": "var(blue)"
		},
		{
			"name": "Heading",
			"scope": "markup.heading, entity.name.section",
			"foreground": "var(cyan_light)",
			"font_style": "bold"
		},
		{
			"name": "Bold",
			"scope": "markup.bold",
			"font_style": "bold"
		},
		{
			"name": "Italic",
			"scope": "markup.italic",
			"font_style": "italic"
		},
		{
			"name": "Link URL",
			"scope": "markup.underline.link",
			"foreground": "var(blue)"
		},
		{
			"name": "Link text",
			"scope": "meta.link.inline.description, meta.link.reference.description, meta.link.reference.literal.description, meta.link.reference.wiki.description",
			"foreground": "var(cyan_light)"
		},
		{
			"name": "Link punctuation",
			"scope": "punctuation.definition.link",
			"foreground": "var(slate)"
		},
		{
			"name": "Inline code",
			"scope": "markup.raw.inline",
			"foreground": "var(green)",
			"background": "color(var(cyan) alpha(0.08))"
		},
		{
			"name": "Inline code backticks",
			"scope": "markup.raw.inline punctuation.definition.raw",
			"foreground": "var(slate)"
		},
		{
			"name": "Code block",
			"scope": "markup.raw.block, markup.raw.code-fence",
			"foreground": "var(white)",
			"background": "var(surface)"
		},
		{
			"name": "Code block with a language",
			"scope": "meta.code-fence.body",
			"background": "var(surface)"
		},
		{
			"name": "Code fence",
			"scope": "meta.code-fence.definition, punctuation.definition.raw.code-fence",
			"foreground": "var(slate)"
		},
		{
			"name": "Code fence language",
			"scope": "constant.other.language-name",
			"foreground": "var(olive)"
		},
		{
			"name": "Heading markers",
			"scope": "punctuation.definition.heading",
			"foreground": "var(slate)"
		},
		{
			"name": "Bold and italic markers",
			"scope": "punctuation.definition.bold, punctuation.definition.italic",
			"foreground": "var(slate)"
		},
		{
			"name": "Quote",
			"scope": "markup.quote",
			"foreground": "color(var(cyan) alpha(0.75))",
			"font_style": "italic"
		},
		{
			"name": "Quote marker",
			"scope": "punctuation.definition.blockquote",
			"foreground": "var(slate)"
		},
		{
			"name": "Alert: note",
			"scope": "markup.heading.alert.note, markup.heading.admonition.note",
			"foreground": "var(cyan)",
			"font_style": "bold"
		},
		{
			"name": "Alert body: note",
			"scope": "markup.quote.alert.note",
			"foreground": "var(cyan)"
		},
		{
			"name": "Alert: tip",
			"scope": "markup.heading.alert.tip, markup.heading.admonition.tip",
			"foreground": "var(green)",
			"font_style": "bold"
		},
		{
			"name": "Alert body: tip",
			"scope": "markup.quote.alert.tip",
			"foreground": "var(green)"
		},
		{
			"name": "Alert: important",
			"scope": "markup.heading.alert.important, markup.heading.admonition.important",
			"foreground": "var(mauve)",
			"font_style": "bold"
		},
		{
			"name": "Alert body: important",
			"scope": "markup.quote.alert.important",
			"foreground": "var(mauve)"
		},
		{
			"name": "Alert: warning",
			"scope": "markup.heading.alert.warning, markup.heading.admonition.warning",
			"foreground": "var(olive)",
			"font_style": "bold"
		},
		{
			"name": "Alert body: warning",
			"scope": "markup.quote.alert.warning",
			"foreground": "var(olive)"
		},
		{
			"name": "Alert: caution",
			"scope": "markup.heading.alert.caution, markup.heading.admonition.caution, markup.heading.admonition.error, markup.heading.alert.error",
			"foreground": "var(red)",
			"font_style": "bold"
		},
		{
			"name": "Alert body: caution",
			"scope": "markup.quote.alert.caution",
			"foreground": "var(red)"
		},
		{
			"name": "List marker",
			"scope": "punctuation.definition.list_item, markup.list.numbered.bullet, markup.list.unnumbered.bullet",
			"foreground": "var(mauve)"
		},
		{
			"name": "Separator",
			"scope": "meta.separator",
			"foreground": "var(slate)"
		},
		{
			"name": "Strikethrough",
			"scope": "markup.strikethrough",
			"foreground": "var(slate)"
		},
		{
			"name": "Inserted",
			"scope": "markup.inserted",
			"foreground": "var(green)"
		},
		{
			"name": "Changed",
			"scope": "markup.changed",
			"foreground": "var(olive)"
		},
		{
			"name": "Deleted",
			"scope": "markup.deleted",
			"foreground": "var(red)"
		},
		{
			"name": "Invalid",
			"scope": "invalid, invalid.illegal",
			"foreground": "var(navy)",
			"background": "var(red)"
		},
		{
			"name": "Deprecated",
			"scope": "invalid.deprecated",
			"foreground": "var(navy)",
			"background": "var(olive)"
		},
		{
			"name": "Region red",
			"scope": "region.redish",
			"foreground": "var(red)"
		},
		{
			"name": "Region orange",
			"scope": "region.orangish",
			"foreground": "var(olive)"
		},
		{
			"name": "Region yellow",
			"scope": "region.yellowish",
			"foreground": "var(olive)"
		},
		{
			"name": "Region green",
			"scope": "region.greenish",
			"foreground": "var(green)"
		},
		{
			"name": "Region cyan",
			"scope": "region.cyanish",
			"foreground": "var(cyan_light)"
		},
		{
			"name": "Region blue",
			"scope": "region.bluish",
			"foreground": "var(blue)"
		},
		{
			"name": "Region purple",
			"scope": "region.purplish",
			"foreground": "var(mauve)"
		},
		{
			"name": "Region pink",
			"scope": "region.pinkish",
			"foreground": "var(mauve)"
		}
	]
}
